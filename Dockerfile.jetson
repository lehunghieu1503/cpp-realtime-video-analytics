# syntax=docker/dockerfile:1
# Jetson (JetPack 6, L4T r36.x, aarch64) image.
# The base ships CUDA 12.6, cuDNN 9, TensorRT 10 and ONNX Runtime 1.20.2 built
# with the CUDA and TensorRT execution providers, headers and libs in /usr/local.
# TensorRT 10 needs ONNX Runtime >= 1.18.
#
# Built on a PC, not on the board:
#   docker buildx build --platform linux/arm64 -f Dockerfile.jetson \
#     -t video-analytics:jetson --load .
# scripts/deploy-jetson.sh does this and ships the result.
ARG BASE_IMAGE=dustynv/onnxruntime:1.20.2-r36.4.0

# Stage 1: Build
FROM ${BASE_IMAGE} AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates ccache wget \
    libopencv-dev libeigen3-dev libmosquitto-dev libssl-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libegl-dev \
    && rm -rf /var/lib/apt/lists/*

# nvbufsurface.h, the interface to the Jetson's hardware video buffers, for
# the zero-copy path. It ships in NVIDIA's multimedia API package, which
# cannot be installed here (it depends on the board's driver packages), so
# the package is downloaded from NVIDIA's repository and only the header is
# taken out. The library itself comes from the board at run time.
RUN wget -qO /etc/apt/trusted.gpg.d/jetson-ota-public.asc \
        https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
    && echo "deb https://repo.download.nvidia.com/jetson/common r36.4 main" \
        > /etc/apt/sources.list.d/nvidia-l4t.list \
    && apt-get update && cd /tmp \
    && apt-get download nvidia-l4t-jetson-multimedia-api \
    && dpkg -x nvidia-l4t-jetson-multimedia-api_*.deb mmapi \
    && cp mmapi/usr/src/jetson_multimedia_api/include/nvbufsurface.h \
          /usr/local/include/ \
    && rm -rf mmapi ./*.deb /etc/apt/sources.list.d/nvidia-l4t.list \
          /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# The optional parts are asked for by name: left to detection, a part whose
# dependency is missing would silently drop out of the image, and the cached
# build directory would keep it out even after the dependency is added.
# CUDA architecture 87 is the Orin's GPU: the pre-processing kernel is
# compiled for it ahead of time instead of at the first frame.
# The build directory and the compiler cache persist between builds, so a
# rebuild under QEMU compiles only what changed. The binary is copied out
# because cache mounts are not part of the image.
RUN --mount=type=cache,target=/app/build \
    --mount=type=cache,target=/root/.ccache \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DWITH_GSTREAMER=ON -DWITH_TENSORRT=ON -DWITH_NVMM=ON \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -DCMAKE_CUDA_ARCHITECTURES=87 \
    && cmake --build build --parallel $(nproc) \
    && cp build/src/video_analytics /app/video_analytics

# Stage 2: Runtime (same base: the GPU libraries are needed at run time)
FROM ${BASE_IMAGE}

# libegl1, libgles2: the NVIDIA GStreamer plugins (nvv4l2decoder,
# nvarguscamerasrc) fail to load without libEGL.so.1 and libGLESv2.so.2.
# gstreamer1.0-libav: software H.264/H.265 decode for RTSP and MP4.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core4.5d \
    libopencv-imgcodecs4.5d \
    libopencv-imgproc4.5d \
    libopencv-dnn4.5d \
    libopencv-videoio4.5d \
    libopencv-highgui4.5d \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-libav \
    libegl1 libgles2 libmosquitto1 \
    && rm -rf /var/lib/apt/lists/*

# Run as non-root; the video group is needed to open /dev/video* and the GPU
# device nodes. Created before the application is copied in, so that a new
# build changes only the small layers below.
RUN useradd -m -G video appuser

# Copy application binary and web assets.
# Models are not in the image; mount them at /app/models when running.
WORKDIR /app
COPY --from=builder /app/video_analytics .
COPY web/ web/

USER appuser

EXPOSE 9001

# No display in the container, and the published port needs 0.0.0.0
ENTRYPOINT ["./video_analytics", "--headless", "--bind", "0.0.0.0"]
CMD ["--device", "0", "--port", "9001"]
