<?xml version="1.0"?>
<package format="3">
  <name>video_analytics_simulation</name>
  <version>0.1.0</version>
  <description>Drives a CARLA vehicle from the detections and lane of a video-analytics device</description>
  <maintainer email="hewlee789@gmail.com">Hieu Hung Le</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
